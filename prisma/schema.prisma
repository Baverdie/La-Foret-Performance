generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 Role      @relation(fields: [roleId], references: [id])
  roleId               String    @db.ObjectId
  member               Member?   @relation(fields: [memberId], references: [id])
  memberId             String?   @db.ObjectId
  isActive             Boolean   @default(true)
  lastLogin            DateTime?
  passwordSetupToken   String?   @unique
  passwordSetupExpires DateTime?
  accounts             Account[]
  sessions             Session[]
  logs                 Log[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Log {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?  @db.ObjectId
  details   String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  instagram String
  photo     String
  bio       String
  cars      Car[]
  users     User[]
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  model         String
  year          String
  photos        String[]
  containPhotos Int[]    @default([])
  engine        String
  power         String
  modifications String
  story         String
  memberId      String   @db.ObjectId
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  date        DateTime
  location    String
  description String
  photo       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Produit de la boutique (textile, autocollant, cache-plaque, etc.)
// Prix en centimes. La disponibilite est pilotee par isActive + availabilityMode + campagne.
model Product {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String           @unique
  description      String
  details          String[] @default([]) // specs (une par ligne) : matière, technique, coupe…
  category         String // TEXTILE | STICKER | PLATE | OTHER
  images           String[]
  basePrice        Int // centimes
  weightGrams      Int? // pour les frais de port futurs
  availabilityMode String           @default("MADE_TO_ORDER") // MADE_TO_ORDER | PRECOMMANDE
  campaignId       String?          @db.ObjectId
  campaign         Campaign?        @relation(fields: [campaignId], references: [id])
  hasVariants      Boolean          @default(false)
  isActive         Boolean          @default(true)
  order            Int              @default(0)
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Variante d'un produit (taille, couleur). Pas de stock dormant : stockLimit optionnel pour les drops limites.
model ProductVariant {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  productId  String  @db.ObjectId
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String // libelle d'affichage (auto: "Couleur / Taille")
  size       String? // ex. "M", "L", "XL"
  color      String? // ex. "Noir", "Sable"
  sku        String?
  priceDelta Int     @default(0) // centimes, ajout sur le prix de base
  stockLimit Int? // null = illimite
  isActive   Boolean @default(true)
  order      Int     @default(0)
}

// Campagne de precommande (vague de production)
model Campaign {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("DRAFT") // DRAFT | OPEN | CLOSED | IN_PRODUCTION | COMPLETED
  products    Product[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Commande client (checkout invite). Montants en centimes.
model Order {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber           String      @unique
  email                 String
  firstName             String
  lastName              String
  phone                 String?
  addressLine1          String
  addressLine2          String?
  city                  String
  postalCode            String
  country               String      @default("FR")
  subtotal              Int
  shippingCost          Int
  processingFee         Int         @default(0)
  total                 Int
  status                String      @default("PENDING") // PENDING | PAID | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  trackingNumber        String?
  paidAt                DateTime?
  productionStartedAt   DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  refundedAt            DateTime?
  cancelRequestedAt     DateTime?
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  stripeRefundId        String?
  campaignId            String?     @db.ObjectId
  campaign              Campaign?   @relation(fields: [campaignId], references: [id])
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// Ligne de commande avec snapshots (la commande reste lisible si le produit change ensuite).
model OrderItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String   @db.ObjectId
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String   @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String?  @db.ObjectId
  productName  String
  variantLabel String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int
}
